{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": { "@spacelog/shared/*": ["../../packages/shared/*.ts"] }
  },
  "include": ["main/**/*.ts", "dropzone/**/*.ts", "dropzone/**/*.tsx", "settings/**/*.tsx", "../../packages/shared/*.ts"],
  "exclude": ["**/*.test.ts", "dist", "node_modules"]
}
